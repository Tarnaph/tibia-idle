# Project Settings > API (or Connect) in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=

# Prefer the current publishable key. The legacy anon key is also supported by the code.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Used to construct OAuth callback URLs. Do not include a trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
